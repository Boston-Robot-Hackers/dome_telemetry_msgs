<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dome_telemetry_msgs</name>
  <version>0.1.0</version>
  <description>
    Shared flat named-field telemetry messages for Foxglove graphing.
    One message type per source (OAK device, UPS battery, Pi host); each
    publisher lives in its own package and publishes its own source topic.
  </description>
  <maintainer email="pito@salas.com">Pito Salas</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
